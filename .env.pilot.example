# =============================================================================
# ContractRadar — PILOT environment template (placeholders only)
# Copy to a secrets-backed store / local untracked file. NEVER commit real secrets.
# AI, real connectors, and notice delivery stay OFF by default.
# =============================================================================

CONTRACTRADAR_ENV=PILOT
NODE_ENV=production
APP_ENV=pilot
APP_URL=https://pilot.example.invalid
BETTER_AUTH_URL=https://pilot.example.invalid
LOG_LEVEL=info
ALLOW_DEV_DEFAULTS=false
COOKIE_SECURE=true

# Secret references (names only — resolve via your secret manager)
DATABASE_URL=${PILOT_DATABASE_URL_SECRET_REF}
DATABASE_MIGRATE_URL=${PILOT_DATABASE_MIGRATE_URL_SECRET_REF}
REDIS_URL=${PILOT_REDIS_URL_SECRET_REF}
BETTER_AUTH_SECRET=${PILOT_BETTER_AUTH_SECRET_REF}
DOCUMENT_INTELLIGENCE_INTERNAL_TOKEN=${PILOT_DI_INTERNAL_TOKEN_SECRET_REF}
S3_ACCESS_KEY_ID=${PILOT_S3_ACCESS_KEY_ID_SECRET_REF}
S3_SECRET_ACCESS_KEY=${PILOT_S3_SECRET_ACCESS_KEY_SECRET_REF}

# Non-secret endpoints / config
S3_ENDPOINT=https://objects.pilot.example.invalid
S3_REGION=eu-central-1
S3_BUCKET=contractradar-pilot-documents
S3_FORCE_PATH_STYLE=true
DOCUMENT_INTELLIGENCE_URL=https://di.pilot.example.invalid
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav.pilot.internal
CLAMAV_PORT=3310

# Capability defaults — OFF until explicit pilot approval enables them
FEATURE_AI_ENABLED=false
FEATURE_REAL_CONNECTORS_ENABLED=false
FEATURE_NOTICE_DELIVERY_ENABLED=false
FEATURE_AUTONOMOUS_SYNC_ENABLED=false
FEATURE_LIVE_MONITORING=false
FEATURE_AUTO_SEND_NOTICES=false
CONTRACT_AI_PROVIDER=disabled
CONNECTOR_PROVIDER=disabled
NOTICE_DELIVERY_PROVIDER=disabled

# Release identity (filled by release pipeline; placeholders here)
RELEASE_SHA=REPLACE_WITH_GIT_SHA
RELEASE_ID=REPLACE_WITH_RELEASE_ID
IMAGE_DIGEST_WEB=sha256:REPLACE_WITH_IMMUTABLE_DIGEST
IMAGE_DIGEST_DI=sha256:REPLACE_WITH_IMMUTABLE_DIGEST

# Pilot preflight / readiness
PILOT_PREFLIGHT_SYNTHETIC=false
PILOT_READY_OUT_DIR=artifacts/pilot-readiness
