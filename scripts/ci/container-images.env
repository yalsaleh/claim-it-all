# Canonical pinned images for Mode B CI / optional Compose.
# Validated against Docker Hub tag API (2026-07-19). Do not use :latest.
# Digest pinning is a follow-up; keep explicit tags until then.
#
# Do not put minio/minio under GitHub Actions services: — that API cannot pass
# `server /data`, so the official image exits immediately.

POSTGRES_IMAGE=postgres:16.6-alpine
REDIS_IMAGE=redis:7.4.2-alpine
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
# Note: RELEASE.2024-11-17T19-35-56Z does NOT exist on Docker Hub.
# Closest valid tags include RELEASE.2024-11-17T19-35-25Z and RELEASE.2024-11-21T17-21-54Z.
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
# Note: clamav/clamav:1.4.1-41 does NOT exist (removed / never published).
CLAMAV_IMAGE=clamav/clamav:1.5-debian13-slim
