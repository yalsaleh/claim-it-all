# =============================================================================
# ContractRadar — environment template
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://contractradar:contractradar@localhost:5432/contractradar?schema=public

# Redis (queues / cache)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=contractradar-documents
S3_FORCE_PATH_STYLE=true

# Auth (replace before any non-local use)
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=cr_session

# Document Intelligence service
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_INTERNAL_TOKEN=replace-with-internal-service-token

# AI providers (leave unset until configured; never hardcode keys in code)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=

# Feature flags
FEATURE_LIVE_MONITORING=false
FEATURE_AUTO_SEND_NOTICES=false
