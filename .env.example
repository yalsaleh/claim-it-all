# =============================================================================
# ContractRadar — environment template
# Copy to `.env` at the repository root AND/OR `apps/web/.env`.
# Never commit real secrets. Never put secrets in NEXT_PUBLIC_* variables.
# Local Compose credentials below are LOCAL-ONLY — refused in staging/production.
# =============================================================================

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
# Runtime app traffic should use contractradar_app (non-superuser) so RLS is enforced.
# Migrations may use the bootstrap owner role when needed.
DATABASE_URL=postgresql://contractradar_app:contractradar@localhost:5432/contractradar?schema=public
DATABASE_MIGRATE_URL=postgresql://contractradar:contractradar@localhost:5432/contractradar?schema=public
# INTEGRATION_DATABASE_URL=postgresql://contractradar_app:contractradar@localhost:5432/contractradar_test?schema=public

# Auth (Better Auth). Use a long random secret in every non-local environment.
BETTER_AUTH_SECRET=dev-only-secret-change-me-to-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000

# Redis (rate limits, ARQ broker, outbox dispatcher)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally) — private bucket only
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=contractradar-documents
S3_FORCE_PATH_STYLE=true

# Document Intelligence service
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_INTERNAL_TOKEN=dev-internal-token-change-me

# Malware scanner: clamav | fake_test (test only) | disabled_reject_all
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

UPLOAD_MAX_BYTES=52428800
UPLOAD_SESSION_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# Optional: allow known local placeholders (never in production)
ALLOW_DEV_DEFAULTS=true

# Live ingestion verification (Docker required)
# LIVE_INGESTION_TESTS=true
# REQUIRE_LIVE_INGESTION_TESTS=true

# Dev seed passwords (optional — random passwords printed if unset)
# SEED_OWNER_PASSWORD=
# SEED_VIEWER_PASSWORD=

# Dangerous override for non-local DB reset/seed (never set in normal use)
# ALLOW_UNSAFE_DB_RESET=false

# Feature flags
FEATURE_LIVE_MONITORING=false
FEATURE_AUTO_SEND_NOTICES=false
