# Copy to backend.hcl (gitignored) after bootstrap apply.
# Values come from: cd bootstrap && terraform output -raw backend_hcl_example

bucket         = "contractradar-pilot-tfstate-REPLACE_ACCOUNT-us-east-1"
key            = "pilot/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "contractradar-pilot-terraform-locks"
encrypt        = true
