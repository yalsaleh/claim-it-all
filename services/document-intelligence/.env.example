APP_ENV=development
LOG_LEVEL=info
SERVICE_NAME=document-intelligence
DOCUMENT_INTELLIGENCE_INTERNAL_TOKEN=dev-internal-token-change-me
DATABASE_URL=postgresql://contractradar_app:contractradar@localhost:5432/contractradar
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=contractradar-documents
S3_FORCE_PATH_STYLE=true
# clamav | fake_test (APP_ENV=test only) | disabled_reject_all
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=10
ALLOW_DEV_DEFAULTS=true
