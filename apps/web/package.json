{
  "name": "@contractradar/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:integration:embedded": "node scripts/run-integration-embedded.mjs",
    "test:security": "pnpm test:integration:embedded",
    "test:live": "vitest run --config vitest.live.config.ts --reporter=verbose",
    "reconcile:ingestion": "tsx scripts/reconcile-ingestion.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "tsx scripts/safe-db-reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.758.0",
    "@aws-sdk/s3-request-presigner": "3.758.0",
    "@contractradar/authz": "workspace:*",
    "@contractradar/contract-rules": "workspace:*",
    "@contractradar/shared": "workspace:*",
    "@prisma/client": "6.1.0",
    "better-auth": "1.1.14",
    "file-type": "16.5.4",
    "ioredis": "5.4.2",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@contractradar/typescript-config": "workspace:*",
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "17.6.0-beta.15",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "postcss": "8.4.49",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
