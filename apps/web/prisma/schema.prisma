  confidenceExplanation     String?                      @db.Text
  interpretationSummary     String?                      @db.Text
  factsSummary              String?                      @db.Text
  assumptions               Json?
  ambiguities               Json?
  missingEvidenceSummary    Json?
  contradictions            Json?
  status                    ProjectEventSuggestionStatus @default(PENDING_REVIEW)
