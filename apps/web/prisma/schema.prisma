/// Governing contractual framework for a project (main contract, subcontract, …).
model ContractPackage {
  id                             String                @id @default(uuid())
  tenantId                       String
  projectId                      String
  name                           String
  description                    String?
  contractReference              String?
  contractFormFamily             String?
  contractFormEdition            String?
  governingLaw                   String?
  jurisdiction                   String?
  governingLanguage              DocumentLanguage?
  secondaryLanguage              DocumentLanguage?
  effectiveDate                  DateTime?
  commencementDate               DateTime?
  status                         ContractPackageStatus @default(DRAFT)
  currentConfigurationRevisionId String?               @unique
  createdByUserId                String
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  tenant                       Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                      Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy                    User                            @relation("ContractPackageCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentConfigurationRevision ContractConfigurationRevision?  @relation("CurrentConfigurationRevision", fields: [currentConfigurationRevisionId], references: [id], onDelete: SetNull)
  documents                    ContractDocument[]
  documentRelationships        ContractDocumentRelationship[]
  precedenceRules              ContractPrecedenceRule[]
  clauses                      ContractClause[]
  clauseRelationships          ClauseRelationship[]
  definedTerms                 DefinedTerm[]
  clauseTermReferences         ClauseTermReference[]
  crossReferences              CrossReference[]
  parties                      ContractParty[]
  roles                        ContractRole[]
  contactPoints                ContactPoint[]
  obligations                  ContractObligation[]
  noticeRules                  NoticeRule[]
  calendarRules                CalendarRule[]
  configurationRevisions       ContractConfigurationRevision[] @relation("PackageConfigurationRevisions")
  configurationIssues          ContractConfigurationIssue[]
  reviewDecisions              ReviewDecision[]
  analysisRuns                 ContractAnalysisRun[]
  extractionSuggestions        ContractExtractionSuggestion[]
  approvedNoticeRuleSnapshots  ApprovedNoticeRuleSnapshot[]
  projectEvents                ProjectEvent[]
  eventRuleAssessments         EventRuleAssessment[]
  deadlineCalculations         DeadlineCalculation[]
  projectDeadlines             ProjectDeadline[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, projectId, createdAt])
  @@map("contract_package")
}

model ContractDocument {
  id                   String                 @id @default(uuid())
  tenantId             String
  projectId            String
  contractPackageId    String
  sourceDocumentId     String
  documentVersionId    String
  contractDocumentType ContractDocumentType
  title                String
  reference            String?
  executionDate        DateTime?
  effectiveDate        DateTime?
  language             DocumentLanguage       @default(UNKNOWN)
  precedenceRank       Int?
  isExecuted           Boolean                @default(false)
  isCurrent            Boolean                @default(true)
  status               ContractDocumentStatus @default(DRAFT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage       ContractPackage                @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  sourceDocument        SourceDocument                 @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  documentVersion       DocumentVersion                @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  clauses               ContractClause[]
  relationshipsFrom     ContractDocumentRelationship[] @relation("ContractDocRelFrom")
  relationshipsTo       ContractDocumentRelationship[] @relation("ContractDocRelTo")
  precedenceRules       ContractPrecedenceRule[]
  definedTermsEffective DefinedTerm[]                  @relation("DefinedTermEffectiveDocument")

  @@unique([contractPackageId, sourceDocumentId, documentVersionId])
  @@index([tenantId, projectId, contractPackageId])
  @@index([sourceDocumentId])
  @@index([documentVersionId])
  @@map("contract_document")
}

model ContractDocumentRelationship {
  id                     String                           @id @default(uuid())
  tenantId               String
  projectId              String
  contractPackageId      String
  fromContractDocumentId String
  toContractDocumentId   String
  relationshipType       ContractDocumentRelationshipType
  effectiveDate          DateTime?
  scopeDescription       String?
  evidenceSegmentId      String?
  evidenceLocator        Json?
  confirmationStatus     ContractConfirmationStatus       @default(MACHINE_SUGGESTED)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage      ContractPackage  @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  fromContractDocument ContractDocument @relation("ContractDocRelFrom", fields: [fromContractDocumentId], references: [id], onDelete: Cascade)
  toContractDocument   ContractDocument @relation("ContractDocRelTo", fields: [toContractDocumentId], references: [id], onDelete: Cascade)

  @@unique([contractPackageId, fromContractDocumentId, toContractDocumentId, relationshipType])
  @@index([tenantId, projectId, contractPackageId])
  @@map("contract_document_relationship")
}

model ContractPrecedenceRule {
  id                      String                     @id @default(uuid())
  tenantId                String
  projectId               String
  contractPackageId       String
  configurationRevisionId String?
  rank                    Int
  contractDocumentId      String?
  contractDocumentType    ContractDocumentType?
  scope                   ContractPrecedenceScope    @default(GLOBAL)
  scopeDescription        String?
  sourceClauseId          String?
  evidenceSegmentId       String?
  evidenceLocator         Json?
  status                  ContractConfirmationStatus @default(MACHINE_SUGGESTED)
  approvedByUserId        String?
  approvedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage       ContractPackage                @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  configurationRevision ContractConfigurationRevision? @relation(fields: [configurationRevisionId], references: [id], onDelete: SetNull)
  contractDocument      ContractDocument?              @relation(fields: [contractDocumentId], references: [id], onDelete: SetNull)
  sourceClause          ContractClause?                @relation(fields: [sourceClauseId], references: [id], onDelete: SetNull)
  approvedBy            User?                          @relation("PrecedenceRuleApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, contractPackageId])
  @@index([contractPackageId, rank])
  @@index([configurationRevisionId])
  @@map("contract_precedence_rule")
}

/// Logical clause/provision. sourceText is immutable once written; corrections use ClauseTextRevision.
model ContractClause {
  id                     String                 @id @default(uuid())
  tenantId               String
  projectId              String
  contractPackageId      String
  contractDocumentId     String
  documentVersionId      String
  parentClauseId         String?
  clauseNumber           String?
  normalizedClauseNumber String?
  heading                String?
  level                  Int                    @default(0)
  sequence               Int                    @default(0)
  language               DocumentLanguage       @default(UNKNOWN)
  sourceText             String                 @db.Text
  normalizedText         String?                @db.Text
  textChecksum           String
  pageStart              Int?
  pageEnd                Int?
  evidenceSegmentId      String?
  evidenceLocator        Json?
  extractionMethod       ClauseExtractionMethod @default(DETERMINISTIC)
  extractionConfidence   Float?
  reviewStatus           ClauseReviewStatus     @default(MACHINE_SUGGESTED)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage     ContractPackage          @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  contractDocument    ContractDocument         @relation(fields: [contractDocumentId], references: [id], onDelete: Cascade)
  documentVersion     DocumentVersion          @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  parentClause        ContractClause?          @relation("ClauseHierarchy", fields: [parentClauseId], references: [id], onDelete: SetNull)
  childClauses        ContractClause[]         @relation("ClauseHierarchy")
  textRevisions       ClauseTextRevision[]
  relationshipsFrom   ClauseRelationship[]     @relation("ClauseRelFrom")
  relationshipsTo     ClauseRelationship[]     @relation("ClauseRelTo")
  definedTerms        DefinedTerm[]
  termReferences      ClauseTermReference[]
  crossReferencesFrom CrossReference[]         @relation("CrossRefSourceClause")
  precedenceRules     ContractPrecedenceRule[]
  parties             ContractParty[]
  roles               ContractRole[]
  contactPoints       ContactPoint[]
  obligations         ContractObligation[]
  approvedRuleSnapshots ApprovedNoticeRuleSnapshot[]

  @@index([tenantId, projectId, contractPackageId])
  @@index([contractDocumentId, sequence])
  @@index([parentClauseId])
  @@index([documentVersionId])
  @@map("contract_clause")
}

model ClauseTextRevision {
  id               String                   @id @default(uuid())
  tenantId         String
  projectId        String
  contractClauseId String
  revisionNumber   Int
  revisedText      String                   @db.Text
  revisionReason   String?
  revisionKind     ClauseTextRevisionKind
  status           ClauseTextRevisionStatus @default(DRAFT)
  createdByUserId  String
  approvedByUserId String?
  createdAt        DateTime                 @default(now())
  approvedAt       DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractClause ContractClause @relation(fields: [contractClauseId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ClauseTextRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy     User?          @relation("ClauseTextRevisionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractClauseId, revisionNumber])
  @@index([tenantId, projectId, contractClauseId])
  @@map("clause_text_revision")
}

model ClauseRelationship {
