  FUTURE_DELIVERY
}

/// Immutable executable notice-rule copy bound to an approved configuration revision.
model ApprovedNoticeRuleSnapshot {
  id                         String                   @id @default(uuid())
  tenantId                   String
  projectId                  String
  contractPackageId          String
  configurationRevisionId    String
  sourceNoticeRuleId         String
  sourceObligationId         String
  sourceClauseId             String?
  durationValue              Decimal?                 @db.Decimal(12, 4)
  durationUnit               NoticeDurationUnit?
  calendarBasis              NoticeCalendarBasis?
  countingConvention         NoticeCountingConvention
  startDateRule              String?
  endDateRule                String?
  businessDayAdjustment      String?
  timeBarClassification      TimeBarClassification
  ambiguityStatus            NoticeAmbiguityStatus
  recipientRequirements      String?                  @db.Text
  deliveryMethodRequirements String?                  @db.Text
  contentRequirements        String?                  @db.Text
  consequenceText            String?                  @db.Text
  triggerBasis               String?
  noticeCategory             String?
  evidenceSegmentId          String?
  evidenceLocator            Json?
  structuredRule             Json
  reviewDecisionId           String?
  createdAt                  DateTime                 @default(now())

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage       ContractPackage               @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  configurationRevision ContractConfigurationRevision @relation(fields: [configurationRevisionId], references: [id], onDelete: Cascade)
  sourceNoticeRule      NoticeRule                    @relation(fields: [sourceNoticeRuleId], references: [id], onDelete: Restrict)
  sourceObligation      ContractObligation            @relation(fields: [sourceObligationId], references: [id], onDelete: Restrict)
  sourceClause          ContractClause?               @relation(fields: [sourceClauseId], references: [id], onDelete: SetNull)
  reviewDecision        ReviewDecision?               @relation(fields: [reviewDecisionId], references: [id], onDelete: SetNull)
  eventRuleAssessments  EventRuleAssessment[]
  deadlineCalculations  DeadlineCalculation[]
  suggestionRuleCandidates SuggestionRuleCandidate[]
  noticePackages           NoticePackage[]
  noticeRequirementSnapshots NoticeRequirementSnapshot[]
  noticeEvidenceRequirements NoticeEvidenceRequirement[]

  @@index([tenantId, projectId, contractPackageId])
  @@index([configurationRevisionId])
  @@index([sourceNoticeRuleId])
  @@map("approved_notice_rule_snapshot")
}

/// Human-confirmed factual project event (not AI-detected entitlement).
model ProjectEvent {
  id                     String                         @id @default(uuid())
  tenantId               String
  projectId              String
  contractPackageId      String?
  eventReference         String?
  title                  String
  description            String?                        @db.Text
  eventCategory          ProjectEventCategory
  eventSubcategory       String?
  eventStatus            ProjectEventStatus             @default(DRAFT)
  confirmationStatus     ProjectEventConfirmationStatus @default(UNCONFIRMED)
  occurredAt             DateTime?
  becameKnownAt          DateTime?
  receivedAt             DateTime?
  instructionDate        DateTime?
  awarenessDate          DateTime?
  continuingEventStartAt DateTime?
  continuingEventEndAt   DateTime?
  timezone               String
  reportedByUserId       String
  confirmedByUserId      String?
  confirmedAt            DateTime?
  source                 ProjectEventSource             @default(MANUAL)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage      ContractPackage?      @relation(fields: [contractPackageId], references: [id], onDelete: SetNull)
  reportedBy           User                  @relation("ProjectEventReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  confirmedBy          User?                 @relation("ProjectEventConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  dates                ProjectEventDate[]
  evidence             ProjectEventEvidence[]
  roles                ProjectEventRole[]
  eventRuleAssessments EventRuleAssessment[]
  deadlineCalculations DeadlineCalculation[]
  projectDeadlines     ProjectDeadline[]
  acceptedFromSuggestions ProjectEventSuggestion[] @relation("SuggestionAcceptedEvent")
  duplicateOfSuggestions  ProjectEventSuggestion[] @relation("SuggestionDuplicateEvent")
  noticePackages          NoticePackage[]

  @@index([tenantId, projectId, eventStatus])
  @@index([tenantId, projectId, confirmationStatus])
  @@index([contractPackageId])
  @@map("project_event")
}

/// Structured date assertion for trigger-relevant event dates.
model ProjectEventDate {
  id                 String                           @id @default(uuid())
  tenantId           String
  projectId          String
  projectEventId     String
  dateType           ProjectEventDateType
  dateValue          DateTime
  timezone           String
  precision          ProjectEventDatePrecision
  verificationStatus ProjectEventDateVerificationStatus @default(UNVERIFIED)
  assertedByUserId   String
  verifiedByUserId   String?
  verifiedAt         DateTime?
  notes              String?                          @db.Text
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent ProjectEvent @relation(fields: [projectEventId], references: [id], onDelete: Cascade)
  assertedBy   User         @relation("EventDateAsserter", fields: [assertedByUserId], references: [id], onDelete: Restrict)
  verifiedBy   User?        @relation("EventDateVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, projectEventId])
  @@index([projectEventId, dateType])
  @@map("project_event_date")
}

/// Evidence link for a project event (same tenant/project as parent event).
model ProjectEventEvidence {
  id                String                    @id @default(uuid())
  tenantId          String
  projectId         String
  projectEventId    String
  sourceDocumentId  String
  documentVersionId String
  evidenceSegmentId String?
  purpose           ProjectEventEvidencePurpose
  factualNote       String?                   @db.Text
  linkedByUserId    String
  createdAt         DateTime                  @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent    ProjectEvent     @relation(fields: [projectEventId], references: [id], onDelete: Cascade)
  sourceDocument  SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  documentVersion DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  evidenceSegment EvidenceSegment? @relation(fields: [evidenceSegmentId], references: [id], onDelete: SetNull)
  linkedBy        User             @relation("EventEvidenceLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, projectEventId])
  @@index([sourceDocumentId])
  @@index([documentVersionId])
  @@map("project_event_evidence")
}

/// Event-specific actor role (distinct from contract roles).
model ProjectEventRole {
  id              String               @id @default(uuid())
  tenantId        String
  projectId       String
  projectEventId  String
  roleType        ProjectEventRoleType
  partyName       String?
  organization    String?
  contractPartyId String?
  contractRoleId  String?
  userId          String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent   ProjectEvent    @relation(fields: [projectEventId], references: [id], onDelete: Cascade)
  contractParty  ContractParty?  @relation(fields: [contractPartyId], references: [id], onDelete: SetNull)
  contractRole   ContractRole?   @relation(fields: [contractRoleId], references: [id], onDelete: SetNull)
  user           User?           @relation("ProjectEventRoleUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, projectEventId])
  @@map("project_event_role")
}

/// Human-confirmed link between a project event and an approved notice-rule snapshot.
model EventRuleAssessment {
  id                      String                       @id @default(uuid())
  tenantId                String
  projectId               String
  projectEventId          String
  contractPackageId       String
  configurationRevisionId String
  approvedRuleSnapshotId  String
  applicabilityStatus     EventRuleApplicabilityStatus @default(CANDIDATE)
  assessmentSource        EventRuleAssessmentSource
  reviewerUserId          String?
  reviewedAt              DateTime?
  rationale               String?                      @db.Text
  assumptions             Json?
  unresolvedIssues        Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent          ProjectEvent               @relation(fields: [projectEventId], references: [id], onDelete: Cascade)
  contractPackage       ContractPackage            @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  configurationRevision ContractConfigurationRevision @relation(fields: [configurationRevisionId], references: [id], onDelete: Restrict)
  approvedRuleSnapshot  ApprovedNoticeRuleSnapshot @relation(fields: [approvedRuleSnapshotId], references: [id], onDelete: Restrict)
  reviewer              User?                      @relation("EventRuleAssessor", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  deadlineCalculations  DeadlineCalculation[]
  noticePackages        NoticePackage[]

  @@index([tenantId, projectId, projectEventId])
  @@index([projectEventId, applicabilityStatus])
  @@index([approvedRuleSnapshotId])
  @@map("event_rule_assessment")
}

/// Project-scoped working calendar (execution input for deadline engine).
model ProjectCalendar {
  id                 String                @id @default(uuid())
  tenantId           String
  projectId          String
  name               String
  timezone           String
  workingWeekMask    String?
  defaultWorkingHours Json?
  weekendDays        Json?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  source             ProjectCalendarSource @default(PROJECT_POLICY)
  status             ProjectCalendarStatus @default(DRAFT)
  currentRevisionId  String?               @unique
  createdByUserId    String
  approvedByUserId   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("CalendarCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy      User?                     @relation("CalendarApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  currentRevision ProjectCalendarRevision?  @relation("CurrentCalendarRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions       ProjectCalendarRevision[] @relation("CalendarRevisions")
  deadlineCalculations DeadlineCalculation[]

  @@index([tenantId, projectId, status])
  @@map("project_calendar")
}

/// Immutable approved calendar revision used by deadline calculations.
model ProjectCalendarRevision {
  id                  String                      @id @default(uuid())
  tenantId            String
  projectId           String
  projectCalendarId   String
  revisionNumber      Int
  timezone            String
  workingWeekMask     String?
  weekendDays         Json
  holidayDates        Json?
  specialWorkingDays  Json?
  partialWorkingDays  Json?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  status              ProjectCalendarRevisionStatus @default(DRAFT)
  sourceEvidence      Json?
  approvedByUserId    String?
  approvedAt          DateTime?
  supersedesRevisionId String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectCalendar   ProjectCalendar    @relation("CalendarRevisions", fields: [projectCalendarId], references: [id], onDelete: Cascade)
  approvedBy        User?              @relation("CalendarRevisionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  supersedes        ProjectCalendarRevision?  @relation("CalendarRevisionSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
  supersededBy      ProjectCalendarRevision[] @relation("CalendarRevisionSupersedes")
  asCurrentFor      ProjectCalendar?   @relation("CurrentCalendarRevision")
  exceptions        CalendarException[]
  deadlineCalculations DeadlineCalculation[]

  @@unique([projectCalendarId, revisionNumber])
  @@index([tenantId, projectId, projectCalendarId])
  @@map("project_calendar_revision")
}

/// Holiday or working-day exception on a calendar revision.
model CalendarException {
  id                 String                @id @default(uuid())
  tenantId           String
  projectId          String
  calendarRevisionId String
  exceptionDate      DateTime              @db.Date
  kind               CalendarExceptionKind
  description        String?
  partialHours       Json?
  createdAt          DateTime              @default(now())

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calendarRevision ProjectCalendarRevision @relation(fields: [calendarRevisionId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, calendarRevisionId])
  @@index([calendarRevisionId, exceptionDate])
  @@map("calendar_exception")
}

/// Deterministic deadline calculation with full machine-readable trace.
model DeadlineCalculation {
  id                      String                    @id @default(uuid())
  tenantId                String
  projectId               String
  projectEventId          String
  eventRuleAssessmentId   String
  contractPackageId       String
  configurationRevisionId String
  approvedRuleSnapshotId  String
  calendarRevisionId      String
  projectCalendarId       String
  calculationStatus       DeadlineCalculationStatus @default(DRAFT)
  calculationVersion      Int                       @default(1)
  triggerDateType         ProjectEventDateType
  triggerDateValue        DateTime
  triggerTimezone         String
  triggerDateEvidence     Json?
  durationValue           Decimal?                  @db.Decimal(12, 4)
  durationUnit            NoticeDurationUnit?
  countingConvention      NoticeCountingConvention?
  startDateRule           String?
  endDateRule             String?
  businessDayAdjustment   String?
  calculatedDeadlineAt    DateTime?
  calculatedDeadlineDate  String?
  deadlineTimezone        String
  blockedReason           String?                   @db.Text
  ambiguityFlags          Json?
  calculationTrace        Json
  calculatedByUserId      String
  reviewedByUserId        String?
  reviewedAt              DateTime?
  supersedesCalculationId String?
  recalculationReason     String?                   @db.Text
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent          ProjectEvent               @relation(fields: [projectEventId], references: [id], onDelete: Restrict)
  eventRuleAssessment   EventRuleAssessment        @relation(fields: [eventRuleAssessmentId], references: [id], onDelete: Restrict)
  contractPackage       ContractPackage            @relation(fields: [contractPackageId], references: [id], onDelete: Restrict)
  configurationRevision ContractConfigurationRevision @relation(fields: [configurationRevisionId], references: [id], onDelete: Restrict)
  approvedRuleSnapshot  ApprovedNoticeRuleSnapshot @relation(fields: [approvedRuleSnapshotId], references: [id], onDelete: Restrict)
  calendarRevision      ProjectCalendarRevision    @relation(fields: [calendarRevisionId], references: [id], onDelete: Restrict)
  projectCalendar       ProjectCalendar            @relation(fields: [projectCalendarId], references: [id], onDelete: Restrict)
  calculatedBy          User                       @relation("DeadlineCalculator", fields: [calculatedByUserId], references: [id], onDelete: Restrict)
  reviewedBy            User?                      @relation("DeadlineCalculationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  supersedes            DeadlineCalculation?       @relation("CalculationSupersedes", fields: [supersedesCalculationId], references: [id], onDelete: SetNull)
  supersededBy          DeadlineCalculation[]      @relation("CalculationSupersedes")
  milestones            DeadlineMilestone[]
  projectDeadlines      ProjectDeadline[]
  noticePackages        NoticePackage[]

  @@index([tenantId, projectId, projectEventId])
  @@index([projectEventId, calculationStatus])
  @@index([approvedRuleSnapshotId])
  @@index([calendarRevisionId])
  @@map("deadline_calculation")
}

/// Contractual or internal milestone derived from a calculation.
model DeadlineMilestone {
  id                       String                          @id @default(uuid())
  tenantId                 String
  projectId                String
  deadlineCalculationId    String
  kind                     DeadlineMilestoneKind
  classification           DeadlineMilestoneClassification
  label                    String?
  dueAt                    DateTime?
  dueDate                  String?
  timezone                 String
  offsetDaysBeforeDeadline Int?
  sequence                 Int                             @default(0)
  createdAt                DateTime                        @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deadlineCalculation DeadlineCalculation @relation(fields: [deadlineCalculationId], references: [id], onDelete: Cascade)
  projectDeadlines    ProjectDeadline[]
  notificationIntents NotificationIntent[]

  @@index([tenantId, projectId, deadlineCalculationId])
  @@map("deadline_milestone")
}

/// Internal warning offsets — never alter contractual deadlines.
model DeadlineWarningPolicy {
  id                 String                      @id @default(uuid())
  tenantId           String
  projectId          String
  name               String
  deadlineType       String?
  warningOffsets     Json
  escalationOffsets  Json?
  responsibleRoleType String?
  channelPlaceholder String?
  severity           String?
  status             DeadlineWarningPolicyStatus @default(DRAFT)
  approvedRevisionNumber Int?
  createdByUserId    String
  approvedByUserId   String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("WarningPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("WarningPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, status])
  @@map("deadline_warning_policy")
}

/// Tracked deadline derived from a verified calculation.
model ProjectDeadline {
  id                    String                    @id @default(uuid())
  tenantId              String
  projectId             String
  projectEventId        String
  contractPackageId     String
  deadlineCalculationId String
  deadlineMilestoneId   String?
  title                 String
  deadlineType          String
  dueAt                 DateTime?
  timezone              String
  status                ProjectDeadlineStatus     @default(UPCOMING)
  riskStatus            ProjectDeadlineRiskStatus @default(UNKNOWN)
  responsibleUserId     String?
  responsibleRoleId     String?
  acknowledgedAt        DateTime?
  completedAt           DateTime?
  completionEvidence    Json?
  supersededById        String?                   @unique
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectEvent        ProjectEvent        @relation(fields: [projectEventId], references: [id], onDelete: Restrict)
  contractPackage     ContractPackage     @relation(fields: [contractPackageId], references: [id], onDelete: Restrict)
  deadlineCalculation DeadlineCalculation @relation(fields: [deadlineCalculationId], references: [id], onDelete: Restrict)
  deadlineMilestone   DeadlineMilestone?  @relation(fields: [deadlineMilestoneId], references: [id], onDelete: SetNull)
  responsibleUser     User?               @relation("DeadlineResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleRole     ContractRole?       @relation("DeadlineResponsibleRole", fields: [responsibleRoleId], references: [id], onDelete: SetNull)
  supersededBy        ProjectDeadline?    @relation("DeadlineSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes          ProjectDeadline?    @relation("DeadlineSupersedes")
  statusHistory       DeadlineStatusHistory[]
  notificationIntents NotificationIntent[]
  noticePackages      NoticePackage[]

  @@index([tenantId, projectId, status])
  @@index([projectEventId])
  @@index([deadlineCalculationId])
  @@map("project_deadline")
}

/// Append-only deadline status transition history.
model DeadlineStatusHistory {
  id                String                 @id @default(uuid())
  tenantId          String
  projectId         String
  projectDeadlineId String
  fromStatus        ProjectDeadlineStatus?
  toStatus          ProjectDeadlineStatus
  changedAt         DateTime               @default(now())
  changedByUserId   String?
  reason            String?
  metadata          Json?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDeadline ProjectDeadline @relation(fields: [projectDeadlineId], references: [id], onDelete: Cascade)
  changedBy       User?           @relation("DeadlineStatusChanger", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, projectDeadlineId])
  @@index([projectDeadlineId, changedAt])
  @@map("deadline_status_history")
}

/// Future notification intent — no outbound delivery in Slice 4.
model NotificationIntent {
  id                  String                   @id @default(uuid())
  tenantId            String
  projectId           String
  projectDeadlineId   String
  deadlineMilestoneId String?
  recipientUserId     String?
  recipientRoleId     String?
  channelType         String
  status              NotificationIntentStatus @default(PENDING)
  scheduledAt         DateTime?
  payloadTemplate     Json?
  createdAt           DateTime                 @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDeadline   ProjectDeadline    @relation(fields: [projectDeadlineId], references: [id], onDelete: Cascade)
  deadlineMilestone DeadlineMilestone? @relation(fields: [deadlineMilestoneId], references: [id], onDelete: SetNull)
  recipientUser     User?              @relation("NotificationIntentRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientRole     ContractRole?      @relation("NotificationIntentRecipientRole", fields: [recipientRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, status, scheduledAt])
  @@index([projectDeadlineId])
  @@map("notification_intent")
}

// ---------------------------------------------------------------------------
// Slice 5 — Evidence-backed project-event detection (suggestions only)
// ---------------------------------------------------------------------------

enum DetectionRunStatus {
  QUEUED
  RUNNING
  PARTIALLY_SUCCEEDED
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTERED
}

enum DetectionRunType {
  MANUAL_HISTORICAL_SCAN
  DOCUMENT_RESCAN
  PROJECT_INCREMENTAL_SCAN
  FUTURE_LIVE_MONITORING
}

enum DetectionAnalysisProfile {
  DETERMINISTIC_ONLY
  HYBRID_STANDARD
  HYBRID_ARABIC_ENGLISH
  PAYMENT_FOCUSED
  ACCESS_DELAY_FOCUSED
  CHANGE_FOCUSED
}

enum ProjectEventSuggestionStatus {
  PENDING_REVIEW
  NEEDS_MORE_EVIDENCE
  ACCEPTED
  ACCEPTED_WITH_CHANGES
  REJECTED
  DUPLICATE
  MERGED
  SUPERSEDED
}

enum DetectionConfidenceBand {
  LOW
  MEDIUM
  HIGH
}

enum SuggestionEvidenceRole {
  PRIMARY_SUPPORT
  SUPPORTING
  DATE_SUPPORT
  PARTY_SUPPORT
  IMPACT_SUPPORT
  CONTRADICTING
  CONTEXT
  DUPLICATE_SIGNAL
  MISSING_EXPECTED_EVIDENCE
}

enum DateSuggestionStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum DetectionGapStatus {
  OPEN
  RESOLVED
  WAIVED
  SUPERSEDED
}

enum SuggestionRuleCandidateStatus {
  CANDIDATE
  REVIEWED
  SELECTED
  REJECTED
  UNCERTAIN
}

enum DetectionContextType {
  EMAIL_THREAD
  RFI_THREAD
  INSTRUCTION_RESPONSE
  FOLLOW_UP_SEQUENCE
  MEETING_SEQUENCE
  DAILY_REPORT_SEQUENCE
  PAYMENT_SEQUENCE
  DRAWING_REVISION_CHAIN
  VARIATION_CHAIN
  OTHER
}

model ProjectEventDetectionRun {
  id                       String                    @id @default(uuid())
  tenantId                 String
  projectId                String
  analysisProfile          DetectionAnalysisProfile  @default(DETERMINISTIC_ONLY)
  status                   DetectionRunStatus        @default(QUEUED)
  runType                  DetectionRunType
  sourceScope              Json?
  sourceDocumentVersionIds Json?
  startedByUserId          String
  processorName            String
  processorVersion         String
  rulesetVersion           String
  promptVersion            String?
  modelProvider            String?
  modelName                String?
  queuedAt                 DateTime                  @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  failureCode              String?
  failureMessageSafe       String?
  correlationId            String
  documentsConsidered      Int                       @default(0)
  segmentsConsidered       Int                       @default(0)
  suggestionsCreated       Int                       @default(0)
  warnings                 Json?
  createdAt                DateTime                  @default(now())

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy     User                      @relation("DetectionRunStarter", fields: [startedByUserId], references: [id], onDelete: Restrict)
  suggestions   ProjectEventSuggestion[]
  contextGroups DetectionContextGroup[]

  @@index([tenantId, projectId, status, queuedAt])
  @@index([correlationId])
  @@map("project_event_detection_run")
}

model DetectionContextGroup {
  id                 String                   @id @default(uuid())
  tenantId           String
  projectId          String
  detectionRunId     String?
  contextType        DetectionContextType
  documentVersionIds Json?
  evidenceSegmentIds Json?
  dateRangeStart     DateTime?
  dateRangeEnd       DateTime?
  participants       Json?
  groupingMethod     String
  confidenceBand     DetectionConfidenceBand  @default(LOW)
  createdAt          DateTime                 @default(now())

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
