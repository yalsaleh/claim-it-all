  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  approvedBy    User?         @relation("NoticeFactApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_fact")
}

model NoticeTemplate {
  id                String               @id @default(uuid())
  tenantId          String?
  scope             String               @default("SYSTEM")
  contractFormFamily String?
  noticeType        NoticeType
  language          String
  jurisdiction      String?
  templateName      String
  description       String?              @db.Text
  status            NoticeTemplateStatus @default(DRAFT)
  version           String
  createdByUserId   String?
  approvedByUserId  String?
  createdAt         DateTime             @default(now())
  approvedAt        DateTime?

  tenant     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?                   @relation("NoticeTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy User?                   @relation("NoticeTemplateApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sections   NoticeTemplateSection[]

  @@index([tenantId, noticeType, language, status])
  @@map("notice_template")
}

model NoticeTemplateSection {
  id                  String                 @id @default(uuid())
  tenantId            String?
  noticeTemplateId    String
  sectionType         NoticeDraftSectionType
  sequence            Int
  required            Boolean                @default(true)
  conditionalInclusion String?
  allowedFactTypes    Json?
  allowedClauseRefs   Json?
  language            String
  reviewerInstructions String?               @db.Text
  externalContentHint String?                @db.Text
  internalGuidance    String?                @db.Text
  createdAt           DateTime               @default(now())

  tenant   Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template NoticeTemplate  @relation(fields: [noticeTemplateId], references: [id], onDelete: Cascade)

  @@index([noticeTemplateId, sequence])
  @@map("notice_template_section")
}

model NoticeDraftRevision {
  id                              String                     @id @default(uuid())
  tenantId                        String
  projectId                       String
  noticePackageId                 String
  revisionNumber                  Int
  status                          NoticeDraftRevisionStatus  @default(DRAFT)
  language                        String
  templateVersion                 String
  generatedBy                     String
  generatorVersion                String
  promptVersion                   String?
  providerMetadata                Json?
  basedOnEvidenceAssessmentRevision Int?
  basedOnRequirementSnapshotId    String?
  createdByUserId                 String
  createdAt                       DateTime                   @default(now())
  submittedAt                     DateTime?
  approvedAt                      DateTime?
  supersedesRevisionId            String?
  validationSnapshot              Json?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage         @relation("NoticePackageDrafts", fields: [noticePackageId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation("NoticeDraftCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  supersedes    NoticeDraftRevision?  @relation("NoticeDraftSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
  supersededBy  NoticeDraftRevision[] @relation("NoticeDraftSupersedes")
  asActiveFor   NoticePackage?        @relation("ActiveApprovedNoticeRevision")
  sections      NoticeDraftSection[]
  reviewComments NoticeReviewComment[]
  approvalDecisions NoticeApprovalDecision[]
  exportBundles NoticeExportBundle[]

  @@unique([noticePackageId, revisionNumber])
  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_draft_revision")
}

model NoticeDraftSection {
  id                 String                        @id @default(uuid())
  tenantId           String
  projectId          String
  draftRevisionId    String
  sectionType        NoticeDraftSectionType
  sequence           Int
  heading            String
  body               String                        @db.Text
  language           String
  sourceFactIds      Json?
  sourceEvidenceRefs Json?
  sourceClauseRefs   Json?
  machineGenerated   Boolean                       @default(true)
  humanEdited        Boolean                       @default(false)
  internalOnly       Boolean                       @default(false)
  reviewStatus       NoticeDraftSectionReviewStatus @default(PENDING)
  warnings           Json?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draftRevision NoticeDraftRevision @relation(fields: [draftRevisionId], references: [id], onDelete: Cascade)
  reviewComments NoticeReviewComment[]

  @@index([tenantId, projectId, draftRevisionId])
  @@map("notice_draft_section")
}

model NoticeDeliveryPreparation {
  id                 String                           @id @default(uuid())
  tenantId           String
  projectId          String
  noticePackageId    String
  recipientRole      String?
  recipientParty     String?
  namedRecipient     String?
  physicalAddress    String?                          @db.Text
  emailAddress       String?
  platformAddress    String?
  attentionLine      String?
  permittedMethod    String?
  selectedMethod     String?
  copiedRecipient    Boolean                          @default(false)
  sourceClauseRef    String?
  sourceEvidence     Json?
  verificationStatus NoticeDeliveryVerificationStatus @default(UNVERIFIED)
  reviewerApproved   Boolean                          @default(false)
  contactPointId     String?
  obligationRecipientId String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_delivery_preparation")
}

model NoticeAttachment {
  id                String                         @id @default(uuid())
  tenantId          String
  projectId         String
  noticePackageId   String
  sourceDocumentId  String?
  documentVersionId String?
  evidenceLocator   Json?
  category          NoticeAttachmentCategory
  externalFilename  String
  description       String?
  inclusionStatus   NoticeAttachmentInclusionStatus @default(PROPOSED)
  sequence          Int                            @default(0)
  confidentialityLabel String?
  checksumSha256    String?
  addedByUserId     String
  reviewedByUserId  String?
  createdAt         DateTime                       @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  addedBy       User          @relation("NoticeAttachmentAdder", fields: [addedByUserId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("NoticeAttachmentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_attachment")
}

model NoticeExportBundle {
  id                 String            @id @default(uuid())
  tenantId           String
  projectId          String
  noticePackageId    String
  draftRevisionId    String
  format             NoticeExportFormat
  artifactChecksum   String
  storageKey         String?
  artifactBytes      Int?
  manifest           Json
  templateVersion    String
  generatedAt        DateTime          @default(now())
  generatedByUserId  String
  language           String
  immutable          Boolean           @default(true)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage       @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  draftRevision NoticeDraftRevision @relation(fields: [draftRevisionId], references: [id], onDelete: Restrict)
  generatedBy   User                @relation("NoticeExportGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, noticePackageId])
  @@index([draftRevisionId])
  @@map("notice_export_bundle")
}

model NoticeReviewComment {
  id              String                    @id @default(uuid())
  tenantId        String
  projectId       String
  noticePackageId String
  draftRevisionId String
  sectionId       String?
  commentType     NoticeReviewCommentType
  commentText     String                    @db.Text
  internalOnly    Boolean                   @default(true)
  status          NoticeReviewCommentStatus @default(OPEN)
  raisedByUserId  String
  assignedToUserId String?
  resolvedByUserId String?
  createdAt       DateTime                  @default(now())
  resolvedAt      DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage        @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  draftRevision NoticeDraftRevision  @relation(fields: [draftRevisionId], references: [id], onDelete: Cascade)
  section       NoticeDraftSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  raisedBy      User                 @relation("NoticeCommentRaiser", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  resolvedBy    User?                @relation("NoticeCommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_review_comment")
}

model NoticeApprovalDecision {
  id                 String                     @id @default(uuid())
  tenantId           String
  projectId          String
  noticePackageId    String
  draftRevisionId    String
  decision           NoticeApprovalDecisionType
  actorUserId        String
  actorRole          String?
  rationale          String?                    @db.Text
  conditions         String?                    @db.Text
  validationSnapshot Json?
  decidedAt          DateTime                   @default(now())

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage       @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  draftRevision NoticeDraftRevision @relation(fields: [draftRevisionId], references: [id], onDelete: Cascade)
  actor         User                @relation("NoticeApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, noticePackageId])
  @@index([draftRevisionId, decidedAt])
  @@map("notice_approval_decision")
}

model NoticeControlledException {
  id              String   @id @default(uuid())
  tenantId        String
  projectId       String
  noticePackageId String
  issueCategory   String
  description     String   @db.Text
  risk            String?  @db.Text
  contractualImpact String? @db.Text
  approvedException Boolean @default(true)
  approvedByUserId String
  expiryOrReviewAt DateTime?
  rationale       String   @db.Text
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noticePackage NoticePackage @relation(fields: [noticePackageId], references: [id], onDelete: Cascade)
  approvedBy    User          @relation("NoticeExceptionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, noticePackageId])
  @@map("notice_controlled_exception")
}
