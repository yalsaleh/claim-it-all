model NoticePackage {
  id                           String              @id @default(uuid())
  tenantId                     String
  projectId                    String
  contractPackageId            String
  configurationRevisionId      String
  approvedNoticeRuleSnapshotId String
  projectEventId               String
  eventRuleAssessmentId        String
  deadlineCalculationId        String
  projectDeadlineId            String?
  noticeType                   NoticeType
  title                        String
  reference                    String?
  status                       NoticePackageStatus @default(DRAFT)
  language                     String
  secondaryLanguage            String?
  languageLayout               NoticeLanguageLayout @default(ENGLISH_ONLY)
  governingLanguage            String?
  priority                     NoticePriority      @default(NORMAL)
  deadlineAt                   DateTime?
  deadlineTimezone             String?
  internalOwnerUserId          String?
  reviewLeadUserId             String?
  approverUserId               String?
  createdByUserId              String
  activeApprovedRevisionId     String?             @unique
  sodEnforced                  Boolean             @default(true)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  tenant                     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage            ContractPackage              @relation(fields: [contractPackageId], references: [id], onDelete: Restrict)
  configurationRevision      ContractConfigurationRevision @relation(fields: [configurationRevisionId], references: [id], onDelete: Restrict)
  approvedNoticeRuleSnapshot ApprovedNoticeRuleSnapshot   @relation(fields: [approvedNoticeRuleSnapshotId], references: [id], onDelete: Restrict)
  projectEvent               ProjectEvent                 @relation(fields: [projectEventId], references: [id], onDelete: Restrict)
  eventRuleAssessment        EventRuleAssessment          @relation(fields: [eventRuleAssessmentId], references: [id], onDelete: Restrict)
  deadlineCalculation        DeadlineCalculation          @relation(fields: [deadlineCalculationId], references: [id], onDelete: Restrict)
  projectDeadline            ProjectDeadline?             @relation(fields: [projectDeadlineId], references: [id], onDelete: SetNull)
  createdBy                  User                         @relation("NoticePackageCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  internalOwner              User?                        @relation("NoticePackageOwner", fields: [internalOwnerUserId], references: [id], onDelete: SetNull)
  reviewLead                 User?                        @relation("NoticePackageReviewLead", fields: [reviewLeadUserId], references: [id], onDelete: SetNull)
  approver                   User?                        @relation("NoticePackageApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  activeApprovedRevision     NoticeDraftRevision?         @relation("ActiveApprovedNoticeRevision", fields: [activeApprovedRevisionId], references: [id], onDelete: SetNull)

  requirementSnapshots       NoticeRequirementSnapshot[]
  evidenceRequirements       NoticeEvidenceRequirement[]
  evidenceLinks              NoticeEvidenceLink[]
  completenessAssessments    EvidenceCompletenessAssessment[]
  reviewQuestions            NoticeReviewQuestion[]
  facts                      NoticeFact[]
  draftRevisions             NoticeDraftRevision[]        @relation("NoticePackageDrafts")
  deliveryPreparations       NoticeDeliveryPreparation[]
  attachments                NoticeAttachment[]
  exportBundles              NoticeExportBundle[]
  reviewComments             NoticeReviewComment[]
  approvalDecisions          NoticeApprovalDecision[]
  controlledExceptions       NoticeControlledException[]

  @@index([tenantId, projectId, status])
  @@index([projectEventId])
  @@index([deadlineCalculationId])
  @@map("notice_package")
}

