/// Versioned snapshot of structured contract interpretation. APPROVED rows are immutable.
model ContractConfigurationRevision {
  id                      String                      @id @default(uuid())
  tenantId                String
  projectId               String
  contractPackageId       String
  revisionNumber          Int
  status                  ConfigurationRevisionStatus @default(DRAFT)
  summary                 String?
  basedOnDocumentVersions Json?
  isActiveApproved        Boolean                     @default(false)
  createdByUserId         String
  submittedByUserId       String?
  approvedByUserId        String?
  submittedAt             DateTime?
  approvedAt              DateTime?
  supersedesRevisionId    String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  tenant          Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage ContractPackage                 @relation("PackageConfigurationRevisions", fields: [contractPackageId], references: [id], onDelete: Cascade)
  createdBy       User                            @relation("ConfigurationRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy     User?                           @relation("ConfigurationRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedBy      User?                           @relation("ConfigurationRevisionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  supersedes      ContractConfigurationRevision?  @relation("ConfigurationRevisionSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
  supersededBy    ContractConfigurationRevision[] @relation("ConfigurationRevisionSupersedes")
  asCurrentFor    ContractPackage?                @relation("CurrentConfigurationRevision")
  precedenceRules ContractPrecedenceRule[]
  definedTerms    DefinedTerm[]
  obligations     ContractObligation[]
  noticeRules     NoticeRule[]
  calendarRules   CalendarRule[]
  issues          ContractConfigurationIssue[]
  reviewDecisions             ReviewDecision[]
  analysisRuns                ContractAnalysisRun[]
  approvedNoticeRuleSnapshots ApprovedNoticeRuleSnapshot[]
  eventRuleAssessments        EventRuleAssessment[]
  deadlineCalculations        DeadlineCalculation[]

  noticePackages                 NoticePackage[]

  @@unique([contractPackageId, revisionNumber])
  @@index([tenantId, projectId, contractPackageId])
  @@index([contractPackageId, status])
  @@map("contract_configuration_revision")
}

