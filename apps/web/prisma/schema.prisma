  evidenceLocator    Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage ContractPackage @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  fromClause      ContractClause  @relation("ClauseRelFrom", fields: [fromClauseId], references: [id], onDelete: Cascade)
  toClause        ContractClause  @relation("ClauseRelTo", fields: [toClauseId], references: [id], onDelete: Cascade)

  @@unique([contractPackageId, fromClauseId, toClauseId, relationshipType])
  @@index([tenantId, projectId, contractPackageId])
  @@map("clause_relationship")
}

model DefinedTerm {
  id                          String            @id @default(uuid())
  tenantId                    String
  projectId                   String
  contractPackageId           String
  term                        String
  normalizedTerm              String
  definitionText              String            @db.Text
  sourceClauseId              String?
  evidenceSegmentId           String?
  evidenceLocator             Json?
  language                    DocumentLanguage  @default(UNKNOWN)
  scopeDescription            String?
  effectiveContractDocumentId String?
  status                      DefinedTermStatus @default(MACHINE_SUGGESTED)
  configurationRevisionId     String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  tenant                    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                   Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractPackage           ContractPackage                @relation(fields: [contractPackageId], references: [id], onDelete: Cascade)
  sourceClause              ContractClause?                @relation(fields: [sourceClauseId], references: [id], onDelete: SetNull)
